.wide-card {
  display: block;
  width: 90%;
  max-width: 900px;
  height: 180px;
  margin: 40px auto;
  border-radius: 12px;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.2);
  /* Sötétített háttérkép, amely felett jól olvasható a szöveg */
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
              url('https://images.unsplash.com/photo-1541643600914-78b084683601?q=80&w=1200&auto=format&fit=crop');
  background-size: cover;
  background-position: center;
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  z-index: 10; /* A részecskék felett jelenik meg */
}

/* Sima mozgás effektus, ha fölé viszed az egeret */
.wide-card:hover {
  transform: translateY(-4px) scale(1.01);
  border-color: rgba(255, 255, 255, 0.8);
  box-shadow: 0 10px 30px rgba(255, 255, 255, 0.1);
}

.card-content {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.card-content h2 {
  color: #ffffff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  font-size: 2.2rem;
  font-weight: 300;
  letter-spacing: 6px;
  text-transform: uppercase;
  margin: 0;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
}
